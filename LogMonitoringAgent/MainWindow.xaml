<Window x:Class="LogMonitoringAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Monitoring Agent"
        Height="350"
        Width="450"
        ResizeMode="CanMinimize">
        <Grid Margin="20">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="Log Monitoring Agent"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 20"/>

                <!-- Username -->
                <StackPanel Grid.Row="1"
                            Orientation="Vertical"
                            Margin="0 0 0 8">
                        <TextBlock Text="Username"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Height="26"
                                 TextChanged="InputField_Changed"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="2"
                            Orientation="Vertical"
                            Margin="0 0 0 8">
                        <TextBlock Text="Password"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="26"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                </StackPanel>

                <!-- Machine Code -->
                <StackPanel Grid.Row="3"
                            Orientation="Vertical"
                            Margin="0 0 0 8">
                        <TextBlock Text="Machine Code"/>
                        <TextBox x:Name="MachineCodeTextBox"
                                 Height="26"
                                 TextChanged="InputField_Changed"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0 10 0 10">
                        <Button x:Name="LoginButton"
                                Content="Login"
                                Width="100"
                                IsEnabled="False"
                                Click="LoginButton_Click"/>
                        <Button x:Name="StartMonitoringButton"
                                Content="Start Monitoring"
                                Width="150"
                                IsEnabled="False"
                                Click="StartMonitoringButton_Click"/>

                </StackPanel>


                <!-- Status -->
                <TextBlock Grid.Row="5"
                           x:Name="StatusTextBlock"
                           Text="Status: Not logged in"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="Gray"/>
        </Grid>
</Window>
