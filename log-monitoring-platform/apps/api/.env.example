# PostgreSQL connection string from terraform output azure_db_host
DATABASE_URL=postgresql://dbadmin:YourPassword@<azure_db_host>:5432/postgres?sslmode=require

# JWT secret — use a long random string in production
JWT_SECRET=change-this-to-a-random-secret

# Server port — keep 3000 for production (pipeline expects it)
PORT=3000

# CORS — frontend URL. In production: http://<azure_vm_ip>:30090
CORS_ORIGIN=http://localhost:5173

# AI threat analysis — set to "true" to enable Gemini
USE_AI_THREAT=false
GEMINI_API_KEY=

# ML service — inside Kubernetes this becomes http://ml-service:8001/analyze-log-batch
ML_SERVICE_URL=http://127.0.0.1:8001/analyze-log-batch

# AWS S3 — from terraform output
AWS_REGION=ap-south-1
AWS_S3_BUCKET=logguard-assets-xxxxxxxx
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=